# GEMINI_API_KEY: Required for optional Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Optional administrator claim/sign-in passcode for CompareX Admin Console.
# Leave unset during local/preview testing to use the first-run Admin Setup form or Firebase Google Admin sign-in.
ADMIN_PASSCODE=
